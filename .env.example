# Copy to .env.production.local (production builds only — local dev stays silent) and fill in.
# Vite only exposes variables prefixed with VITE_. Both .env.local and .env.*.local are gitignored.

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX, from Admin → Data streams).
# Leave empty to keep analytics turned off.
VITE_GA_MEASUREMENT_ID=
